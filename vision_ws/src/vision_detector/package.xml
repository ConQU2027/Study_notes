<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vision_detector</name>
  <version>0.3.0</version>
  <description>Two-node vision example with TF, RViz and debug image output.</description>
  <maintainer email="934198139@qq.com">lcx</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>image_transport</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>OpenCV</depend>
  <depend>vision_interfaces</depend>

  <exec_depend>rviz2</exec_depend>
  <exec_depend>rqt_image_view</exec_depend>
  <exec_depend>rqt_graph</exec_depend>
  <exec_depend>rqt_plot</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
